# NekoBot QQ 机器人配置文件
# 复制此文件为 .env 并填入真实配置

# ==================== Bot 后端配置（双轨并列）====================
# 优先级: 同时配置时 ncatbot 优先；只配 QQBOT_* 则走 QQ Bot 官方机器人
# 阶段 1 重构: 新增 QQ Bot 官方机器人支持,保留 ncatbot 向后兼容

# ---- 选项 A: ncatbot + NapCat (旧版, 保留向后兼容) ----
BOT_UIN=你的QQ号
ROOT=管理员QQ号
WS_URI=ws://你的NapCat地址:端口
TOKEN=你的NapCat令牌（可选）

# ---- 选项 B: QQ Bot 官方机器人（推荐, 无需 NapCat）----
# 在 https://q.qq.com 创建机器人,获取 AppID 和 AppSecret
QQBOT_APP_ID=你的AppID
QQBOT_APP_SECRET=你的AppSecret
# 可选配置
QQBOT_SANDBOX=false
QQBOT_API_BASE=    # 留空使用默认 https://api.sgroup.qq.com

# ==================== AI API 配置 ====================
# 主要 AI API 
API_KEY=
BASE_URL=
MODEL=

# ==================== Web 配置 ====================
WEB_PASSWORD=你的Web界面密码

# ==================== HTTPS 配置 ====================
# 启用 HTTPS（true/false），启用后需提供证书或使用自签名
HTTPS=false
# 自签名证书（true=自动生成，false=使用下面指定的证书文件）
SSL_SELF_SIGNED=false
# SSL 证书文件路径（PEM 格式）
SSL_CERTFILE=
# SSL 私钥文件路径（PEM 格式）
SSL_KEYFILE=

# ==================== 聊天配置 ====================
MAX_HISTORY_LENGTH=50
NBOT_AUTO_MEMORY_ENABLED=1

# ==================== 图片识别配置 ====================
PIC_MODEL=zai-org/GLM-4.6V

# ==================== 缓存配置 ====================
CACHE_ADDRESS=/path/to/cache/directory

# ==================== 语音配置 ====================
VOICE=fnlp/MOSS-TTSD-v0.5:diana

# ==================== 搜索配置 ====================
SEARCH_API_KEY=你的搜索API密钥
SEARCH_API_URL=你的搜索API地址

# ==================== 视频配置 ====================
VIDEO_API_KEY=你的视频API密钥

# ==================== GitHub 配置 ====================
GF_API_KEY=你的GitHub_API密钥

# ==================== PDF 配置 ====================
PDF_API_KEY=你的PDF_API密钥

# ==================== Telegram 配置 ====================
TELEGRAM_BOT_TOKEN=你的Telegram_Bot_Token
TELEGRAM_WEBHOOK_SECRET=你的Telegram_Webhook_Secret（可选）

# ==================== 飞书配置 ====================
# 飞书自建应用凭证（用于 Webhook 或长连接模式）
FEISHU_APP_ID=你的飞书_App_ID
FEISHU_APP_SECRET=你的飞书_App_Secret
FEISHU_ENCRYPT_KEY=你的飞书_Encrypt_Key（可选）
FEISHU_VERIFICATION_TOKEN=你的飞书_Verification_Token（可选）
